import { Head, router, usePage } from "@inertiajs/react";
import AppLayout from "@/layouts/app-layout";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { ArrowLeft, Edit, Users, Gift, QrCode, MessageCircle, Calendar, Clock, MapPin } from "lucide-react";

export default function EventShow() {
  const { props } = usePage();
  const acara = (props.acara as any) || {};

  // Memastikan stats memiliki fallback nilai default
  const stats = (props.stats as any) || {
    total_tamu: 0,
    total_pax: 0,
    hadir: 0,
    akan_datang: 0,
    tidak_hadir: 0,
  };

  const getStatusBadge = (status: string) => {
    const s = status?.toLowerCase() || "draft";
    const cfg: Record<string, {label: string; cls: string}> = {
      active: {label: "Aktif", cls: "bg-emerald-100 text-emerald-700"},
      draft: {label: "Draft", cls: "bg-amber-100 text-amber-700"},
      completed: {label: "Selesai", cls: "bg-blue-100 text-blue-700"},
      archived: {label: "Arsip", cls: "bg-gray-100 text-gray-700"},
    };
    const c = cfg[s] || cfg.draft;
    return <span className={`px-3 py-1 rounded-full text-xs font-medium ${c.cls}`}>{c.label}</span>;
  };

  // FUNGSI MEMOTONG JAM PADA TANGGAL
  const formatDate = (dateString: string) => {
    if (!dateString) return "-";
    const dateOnly = dateString.split('T')[0].split(' ')[0];

    try {
      const dateObj = new Date(dateOnly);
      return dateObj.toLocaleDateString("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric"
      });
    } catch (e) {
      return dateOnly;
    }
  };

  return (
    <AppLayout>
      <Head title={acara.nama || "Event Detail"} />
      <div className="p-6 space-y-6 w-full">

        {/* Header */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div className="flex items-center gap-4">
            <Button variant="ghost" onClick={() => router.get("/events")}>
              <ArrowLeft className="w-4 h-4 mr-2" />
              Kembali
            </Button>
            <div>
              <h1 className="text-2xl font-bold">{acara.nama}</h1>
              <div className="flex items-center gap-3 mt-2">
                {getStatusBadge(acara.status)}
                <span className="text-gray-500 text-sm flex items-center gap-1">
                  <Calendar className="w-4 h-4" /> {formatDate(acara.tanggal)}
                </span>
              </div>
            </div>
          </div>
          <div className="flex gap-2">
            <Button className="bg-emerald-600 hover:bg-emerald-700 text-white" onClick={() => router.get(`/events/${acara.id}/edit`)}>
              <Edit className="w-4 h-4 mr-2" />
              Edit Event
            </Button>
          </div>
        </div>

        {/* Stats Cards */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <Card>
            <CardContent className="p-6 flex items-center gap-4">
              <div className="p-3 bg-blue-100 rounded-full">
                <Users className="w-6 h-6 text-blue-600" />
              </div>
              <div>
                <p className="text-2xl font-bold">{stats.total_tamu || 0}</p>
                <p className="text-sm text-gray-500">Total Tamu ({stats.total_pax || 0} Pax)</p>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6 flex items-center gap-4">
              <div className="p-3 bg-green-100 rounded-full">
                <Users className="w-6 h-6 text-green-600" />
              </div>
              <div>
                <p className="text-2xl font-bold">{stats.hadir || 0}</p>
                <p className="text-sm text-gray-500">Sudah Hadir</p>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6 flex items-center gap-4">
              <div className="p-3 bg-amber-100 rounded-full">
                <Users className="w-6 h-6 text-amber-600" />
              </div>
              <div>
                <p className="text-2xl font-bold">{stats.akan_datang || 0}</p>
                <p className="text-sm text-gray-500">Belum Hadir</p>
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Action Buttons */}
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <Button variant="outline" className="h-14 font-medium" onClick={() => router.get("/guest/tamu?acara_id=" + acara.id)}>
            <Users className="w-5 h-5 mr-2 text-blue-500" />
            Kelola Tamu
          </Button>
          <Button variant="outline" className="h-14 font-medium" onClick={() => router.get("/broadcast?acara_id=" + acara.id)}>
            <MessageCircle className="w-5 h-5 mr-2 text-emerald-500" />
            Broadcast WA
          </Button>
        //   <Button variant="outline" className="h-14 font-medium" onClick={() => router.get("/qr?acara_id=" + acara.id)}>
        //     <QrCode className="w-5 h-5 mr-2 text-purple-500" />
        //     QR Codes
        //   </Button>
        //   <Button variant="outline" className="h-14 font-medium" onClick={() => router.get("/guest/hadiah?acara_id=" + acara.id)}>
        //     <Gift className="w-5 h-5 mr-2 text-amber-500" />
        //     Kelola Hadiah
        //   </Button>
        </div>

        {/* Detail Event */}
        <Card>
          <CardContent className="p-6">
            <h3 className="font-bold text-lg mb-4 border-b pb-2">Detail Event</h3>
            <div className="space-y-4 text-sm mt-4">
              <div className="flex gap-3 items-center">
                <Calendar className="w-4 h-4 text-gray-400" />
                <span className="font-medium w-28 text-gray-500">Tanggal</span>
                <span className="font-semibold">{formatDate(acara.tanggal)}</span>
              </div>
              <div className="flex gap-3 items-center">
                <Clock className="w-4 h-4 text-gray-400" />
                <span className="font-medium w-28 text-gray-500">Waktu</span>
                <span className="font-semibold">{acara.waktu_mulai || "-"}</span>
              </div>
              <div className="flex gap-3 items-center">
                <MapPin className="w-4 h-4 text-gray-400" />
                <span className="font-medium w-28 text-gray-500">Tempat</span>
                <span className="font-semibold">{acara.tempat || "-"}</span>
              </div>
              <div className="flex gap-3 items-center">
                <MapPin className="w-4 h-4 text-gray-400 opacity-0" />
                <span className="font-medium w-28 text-gray-500">Alamat</span>
                <span className="font-semibold text-gray-700">{acara.alamat || "-"}</span>
              </div>
              <div className="flex gap-3 items-center">
                <QrCode className="w-4 h-4 text-gray-400" />
                <span className="font-medium w-28 text-gray-500">QR / Keluarga</span>
                <span className="font-semibold bg-gray-100 px-2 py-1 rounded">{acara.qr_per_keluarga || 4} QR</span>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </AppLayout>
  );
}
